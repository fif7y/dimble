            "state": "translated",
            "value": "In attesa del completamento del primo backup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回バックアップ完了を待機中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 백업 완료 기다리는 중"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando que o Primeiro Backup Termine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание окончания создания первой резервной копии"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待完成第一次备份"
          }
        }
      }
    },
    "Waits %lld seconds, so a wake or a roam doesn't flash it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet %lld Sekunden, damit Aufwachen oder Roaming es nicht aufblitzen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera %lld segundos, para que una reactivación o un cambio de red no lo haga parpadear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend %lld secondes, pour qu’un réveil ou un changement de réseau ne la fasse pas apparaître."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetta %lld secondi, così una riattivazione o un cambio di rete non la fa comparire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld秒待つので、スリープ復帰やネットワークの切り替えで一瞬だけ表示されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초를 기다려서, 잠자기 해제나 네트워크 전환 때 깜박이지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera %lld segundos, para que uma reativação ou troca de rede não o faça piscar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждёт %lld секунд, чтобы выход из сна или смена сети не заставили его мигнуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会等待 %lld 秒，这样唤醒或切换网络时不会闪现。"
          }
        }
      }
    },
