    "Auto fits your icons. Or drag the panel's edge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch passt sich deinen Symbolen an. Oder zieh am Rand des Panels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático se ajusta a tus iconos. O arrastra el borde del panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto s’adapte à vos icônes. Ou faites glisser le bord du panneau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto si adatta alle tue icone. Oppure trascina il bordo del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ではアイコンに合わせます。パネルの端をドラッグすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 아이콘에 맞춥니다. 패널 가장자리를 드래그해도 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático se ajusta aos seus ícones. Ou arraste a borda do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» подстраивается под значки. Или потяните край панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会适应你的图标。也可以拖移面板边缘。"
          }
        }
      }
    },
