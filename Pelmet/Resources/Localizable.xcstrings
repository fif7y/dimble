    "A cog under the icons, bottom right.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zahnrad unter den Symbolen, rechts unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un engranaje bajo los iconos, abajo a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une roue dentée sous les icônes, en bas à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rotella sotto le icone, in basso a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンの下、右下に歯車を表示します。"
          }
        },
