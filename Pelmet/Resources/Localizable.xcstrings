        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É só isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот и весь секрет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就这么简单。"
          }
        }
      }
    },
    "The chevron doesn't fit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pfeil passt nicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chevrón no cabe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chevron ne tient pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La freccia non ci sta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンが収まりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표가 들어가지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seta não cabe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелка не помещается"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "箭头放不下"
          }
        }
      }
    },
    "The chevron is the boundary: everything left of it tucks away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chevron ist die Grenze: Alles links davon wird verstaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chevrón es la frontera: todo lo que queda a su izquierda se recoge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chevron est la frontière : tout ce qui est à sa gauche se range."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il chevron è il confine: tutto ciò che sta a sinistra si ripiega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンが境界です。その左にあるものはすべて隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉐브론이 경계입니다. 왼쪽의 모든 것이 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chevron é a fronteira: tudo à esquerda dele se recolhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шеврон — это граница: всё левее него прячется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尖角符号就是分界线：它左侧的一切都会收起。"
          }
        }
      }
    },
    "The clock always sits at the right edge, so it can't be moved. Drop it in a hidden section to hide it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr sitzt immer am rechten Rand und lässt sich nicht verschieben. Lege sie in einen ausgeblendeten Bereich, um sie zu verstecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj siempre está en el borde derecho, así que no se puede mover. Suéltalo en una sección oculta para ocultarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'horloge reste toujours au bord droit, elle ne peut donc pas être déplacée. Déposez-la dans une section masquée pour la cacher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio sta sempre al bordo destro, quindi non può essere spostato. Trascinalo in una sezione nascosta per nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計は常に右端にあるため移動できません。隠すには非表示セクションにドロップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계는 항상 오른쪽 끝에 있어 옮길 수 없습니다. 숨기려면 숨김 섹션에 놓으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio fica sempre na borda direita, então não pode ser movido. Solte-o em uma seção oculta para escondê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы всегда стоят у правого края, поэтому их нельзя переместить. Перетащите их в скрытый раздел, чтобы скрыть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟始终位于右边缘，无法移动。将它拖到隐藏区域即可隐藏。"
          }
        }
      }
    },
    "The new language applies the next time Dimble opens. Your menu bar layout is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache gilt ab dem nächsten Start von Dimble. Dein Menüleisten-Layout bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplica la próxima vez que se abra Dimble. La disposición de tu barra de menús se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue s’applique à la prochaine ouverture de Dimble. La disposition de votre barre des menus est conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova lingua si applica alla prossima apertura di Dimble. La disposizione della barra dei menu viene conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語は次回Dimbleを開いたときに適用されます。メニューバーの配置はそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어는 다음에 Dimble를 열 때 적용됩니다. 메뉴 막대 배치는 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo idioma vale na próxima vez que o Dimble abrir. A disposição da sua barra de menus é mantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый язык применится при следующем запуске Dimble. Раскладка строки меню сохранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新语言将在下次打开 Dimble 时生效。菜单栏布局会保留。"
          }
        }
      }
    },
    "The same menu opens on a separator and on the empty bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Menü öffnet sich auf einem Trenner und auf der leeren Leiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo menú se abre en un separador y en la barra vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même menu s’ouvre sur un séparateur et sur la barre vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso menu si apre su un separatore e sulla barra vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じメニューが区切り線と空のバーでも開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구분선과 빈 막대에서도 같은 메뉴가 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo menu abre em um separador e na barra vazia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То же меню открывается на разделителе и на пустой строке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在分隔符和空白菜单栏上打开的是同一个菜单。"
          }
        }
      }
    },
    "Their icon isn't in the bar yet. Return opens the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Symbol ist noch nicht in der Leiste. Return öffnet die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su icono aún no está en la barra. Retorno abre la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur icône n’est pas encore dans la barre. Retour ouvre l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La loro icona non è ancora nella barra. Invio apre l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンはまだバーにありません。Returnでアプリを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 막대에 아이콘이 없습니다. Return을 누르면 앱이 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone ainda não está na barra. Return abre o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их значка ещё нет в строке меню. Return открывает приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们的图标尚未出现在菜单栏中。按回车即可打开该 App。"
          }
        }
      }
    },
    "Their pills show next to the «, and hidden system icons come back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kapseln erscheinen neben dem «, ausgeblendete Systemsymbole ebenso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cápsulas aparecen junto al «, y vuelven los iconos del sistema ocultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs capsules s’affichent près du «, et les icônes système masquées aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capsule appaiono accanto al «, e tornano le icone di sistema nascoste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カプセルが « の横に表示され、隠したシステムアイコンも戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐이 « 옆에 표시되고, 숨긴 시스템 아이콘이 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cápsulas aparecem ao lado do «, e os ícones ocultos do sistema voltam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капсулы видны рядом с «, а скрытые системные значки возвращаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胶囊显示在 « 旁边，隐藏的系统图标也会重新出现。"
          }
        }
      }
    },
    "Then turn the original off in %@'s settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte danach das Original in den Einstellungen von %@ aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, desactiva el original en los ajustes de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, désactivez l’originale dans les réglages de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi disattiva l’originale nelle impostazioni di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのあと、%@ の設定で元のアイコンをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 %@ 설정에서 원래 아이콘을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, desative o original nos ajustes de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем отключите оригинал в настройках %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后在 %@ 的设置中关闭原图标。"
          }
        }
      }
    },
    "They slide out beside the chevron.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gleiten neben dem Pfeil heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deslizan junto al chevrón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles sortent à côté du chevron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorrono fuori accanto alla freccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンの横にスライドして現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 옆으로 밀려 나옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas deslizam para fora ao lado da seta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они выезжают рядом со стрелкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会在箭头旁滑出。"
          }
        }
      }
    },
    "Tick what appears, drag to reorder. Settings and Quit always stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake an, was erscheinen soll, und ziehe zum Umsortieren. Einstellungen und Beenden bleiben immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo que aparece y arrastra para reordenar. Ajustes y Salir siempre se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez ce qui apparaît, glissez pour réordonner. Réglages et Quitter restent toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta cosa appare, trascina per riordinare. Impostazioni ed Esci restano sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する項目にチェックを入れ、ドラッグで並べ替えます。設定と終了は常に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시할 항목을 선택하고 끌어서 순서를 바꾸세요. 설정과 종료는 항상 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que aparece e arraste para reordenar. Ajustes e Encerrar ficam sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, что показывать, перетащите для порядка. «Настройки» и «Завершить» остаются всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选要显示的项目，拖动可调整顺序。设置和退出始终保留。"
          }
        }
      }
    },
