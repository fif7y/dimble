    "Needs Screen Recording. Dimble animates the icons over a picture of the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht die Bildschirmaufnahme. Dimble animiert die Symbole über einem Bild der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita la grabación de pantalla. Dimble anima los iconos sobre una imagen de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite l’enregistrement de l’écran. Dimble anime les icônes par-dessus une image de la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede la registrazione schermo. Dimble anima le icone sopra un’immagine della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録が必要です。Dimble はメニューバーの画像の上でアイコンをアニメーションさせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록이 필요합니다. Dimble은 메뉴 막대 이미지 위에서 아이콘을 움직입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer a gravação de tela. O Dimble anima os ícones sobre uma imagem da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна запись экрана. Dimble анимирует значки поверх снимка строки меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要录屏权限。Dimble 在菜单栏的画面上为图标制作动画。"
          }
        }
      }
    },
    "Needs Screen Recording. Dimble draws the pill from a picture of the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht die Bildschirmaufnahme. Dimble zeichnet die Kapsel aus einem Bild der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita la grabación de pantalla. Dimble dibuja la cápsula a partir de una imagen de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite l’enregistrement de l’écran. Dimble dessine la capsule à partir d’une image de la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede la registrazione schermo. Dimble disegna la capsula da un’immagine della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録が必要です。Dimble はメニューバーの画像からカプセルを描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록이 필요합니다. Dimble은 메뉴 막대 이미지로 캡슐을 그립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer a gravação de tela. O Dimble desenha a cápsula a partir de uma imagem da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна запись экрана. Dimble рисует капсулу по снимку строки меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要录屏权限。Dimble 会根据菜单栏的画面绘制胶囊。"
          }
        }
      }
    },
