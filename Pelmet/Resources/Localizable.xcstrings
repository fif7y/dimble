    "Without it: press %@, reopen Dimble from Spotlight, or right-click a separator or empty menu bar spot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Symbol: %@ drücken, Dimble erneut über Spotlight öffnen oder mit der rechten Maustaste auf einen Trenner oder eine freie Stelle der Menüleiste klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él: pulsa %@, vuelve a abrir Dimble desde Spotlight, o haz clic derecho en un separador o en un espacio vacío de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle : appuyez sur %@, rouvrez Dimble depuis Spotlight, ou faites un clic droit sur un séparateur ou une zone vide de la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza icona: premi %@, riapri Dimble da Spotlight, oppure fai clic destro su un separatore o su uno spazio vuoto della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の場合：%@ を押すか、SpotlightからDimbleを再度開くか、区切りまたはメニューバーの空いている場所を右クリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨기면: %@ 를 누르거나, Spotlight에서 Dimble를 다시 열거나, 구분선 또는 메뉴 막대의 빈 곳을 오른쪽 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ele: pressione %@, reabra o Dimble pelo Spotlight, ou clique com o botão direito em um separador ou em um espaço vazio da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без значка: нажмите %@, откройте Dimble через Spotlight или нажмите правой кнопкой на разделитель или пустое место строки меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后：可按 %@，通过 Spotlight 重新打开 Dimble，或右键点击分隔符或菜单栏的空白处。"
          }
        }
      }
    },
    "Without it: reopen Dimble from Spotlight, or right-click a separator or empty menu bar spot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Symbol: Dimble erneut über Spotlight öffnen oder mit der rechten Maustaste auf einen Trenner oder eine freie Stelle der Menüleiste klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él: vuelve a abrir Dimble desde Spotlight, o haz clic derecho en un separador o en un espacio vacío de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle : rouvrez Dimble depuis Spotlight, ou faites un clic droit sur un séparateur ou une zone vide de la barre des menus."
          }
