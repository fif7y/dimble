    "Not in place yet — it hides with this section, but sits on the other side of the chevron until Apply moves it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht an Ort und Stelle — es wird mit dieser Sektion ausgeblendet, sitzt aber auf der anderen Seite des Chevrons, bis Anwenden es verschiebt"
          }
        },
        "es": {
          "stringUnit": {
