    "Names under each icon. Off fits more in a row.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen unter jedem Symbol. Aus passen mehr in eine Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres bajo cada icono. Desactivado, caben más por fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom sous chaque icône. Désactivé, une rangée en contient plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome sotto ogni icona. Disattivato, ne entrano di più in una riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アイコンの下に名前を表示。オフにすると1行により多く並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 아이콘 아래에 이름을 표시합니다. 끄면 한 줄에 더 많이 들어갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes sob cada ícone. Desativado, cabem mais por linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название под каждым значком. Без них в ряд помещается больше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个图标下显示名称。关闭后每行可放下更多图标。"
          }
        }
      }
    },
