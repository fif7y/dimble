    "Out of the panel. Press %@ to reach them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht im Panel. Drücke %@, um sie zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera del panel. Pulsa %@ para llegar a ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors du panneau. Appuyez sur %@ pour y accéder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dal pannello. Premi %@ per raggiungerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルには表示しません。%@ を押すと表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에 표시하지 않습니다. %@을(를) 누르면 찾을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora do painel. Pressione %@ para chegar a eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не в панели. Нажмите %@, чтобы открыть их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在面板中显示。按 %@ 即可找到。"
          }
        }
      }
    },
