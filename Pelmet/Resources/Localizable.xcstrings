    "Stays on while the Dimble icon is hidden. It's your way back here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt an, solange das Dimble-Symbol ausgeblendet ist. So kommst du hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene activo mientras el icono de Dimble está oculto. Es tu camino de vuelta aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste actif tant que l’icône Dimble est masquée. C’est votre chemin de retour ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta attivo finché l’icona di Dimble è nascosta. È la tua via per tornare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimbleのアイコンを隠している間はオンのままです。ここへ戻る手段になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimble 아이콘을 숨긴 동안은 켜진 상태로 유지됩니다. 여기로 돌아오는 길입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica ativo enquanto o ícone do Dimble estiver oculto. É seu caminho de volta para cá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся включённым, пока значок Dimble скрыт. Это ваш путь обратно сюда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimble 图标隐藏时保持开启。这是你回到这里的路。"
          }
        }
      }
    },
