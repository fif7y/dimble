    "Turn this icon off in %@'s settings. The launcher takes over from there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dieses Symbol in den Einstellungen von %@ aus. Ab dann übernimmt der Starter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva este icono en los ajustes de %@. A partir de ahí, el lanzador se encarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette icône dans les réglages de %@. Le lanceur prend le relais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa icona nelle impostazioni di %@. Da lì in poi ci pensa l’avvio app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の設定でこのアイコンをオフにしてください。あとはランチャーが引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 설정에서 이 아이콘을 끄세요. 그 뒤로는 실행기가 맡습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative este ícone nos ajustes de %@. A partir daí, o atalho assume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите этот значок в настройках %@. Дальше всё возьмёт на себя запуск приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 的设置中关闭此图标。之后由启动器接管。"
          }
