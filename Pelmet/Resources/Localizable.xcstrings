          "stringUnit": {
            "state": "translated",
            "value": "아이콘 아래 오른쪽 하단에 톱니바퀴를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma engrenagem sob os ícones, no canto inferior direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шестерёнка под значками, справа внизу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图标下方右下角显示齿轮。"
          }
        }
      }
    },
    "A countdown that stays in view and rings when it ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Countdown, der im Blick bleibt und am Ende klingelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta atrás que se queda a la vista y suena al terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte à rebours qui reste visible et sonne à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto alla rovescia sempre in vista che suona alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に見えるカウントダウン。終了時に鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 보이는 카운트다운. 끝나면 울립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma contagem regressiva que fica à vista e toca ao terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратный отсчёт, который всегда на виду и звонит по окончании."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终可见的倒计时，结束时响铃。"
          }
        }
      }
    },
    "A grid under the chevron, in your menu bar order.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Raster unter dem Pfeil, in der Reihenfolge deiner Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuadrícula bajo el chevrón, en el orden de tu barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une grille sous le chevron, dans l’ordre de votre barre des menus."
          }
        },
