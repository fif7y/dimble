    "Apps that aren't running, dimmed. A click opens one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die nicht laufen, abgeblendet. Ein Klick öffnet sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que no están abiertas, atenuadas. Un clic abre una."
          }
        },
        "fr": {
