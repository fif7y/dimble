          "stringUnit": {
            "state": "translated",
            "value": "启动器已就绪"
          }
        }
      }
    },
    "Keeps the groups you made in the menu bar apart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Gruppen, die du in der Menüleiste gebildet hast, getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene separados los grupos que hiciste en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde séparés les groupes que vous avez faits dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene separati i gruppi che hai creato nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーで作ったグループを分けて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 만든 그룹을 서로 떨어뜨려 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém separados os grupos que você criou na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит раздельно группы, которые вы сделали в строке меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你在菜单栏中建立的分组彼此分开。"
          }
        }
      }
    },
    "Keeps the groups you made in the menu bar together, one row each.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Gruppen, die du in der Menüleiste gebildet hast, zusammen, je eine Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene juntos los grupos que hiciste en la barra de menús, una fila cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ensemble les groupes que vous avez faits dans la barre des menus, une rangée chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene insieme i gruppi che hai creato nella barra dei menu, una riga ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーで作ったグループをまとめ、1グループ1行で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 만든 그룹을 한 줄에 하나씩 모아 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém juntos os grupos que você criou na barra de menus, uma linha cada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит вместе группы, которые вы сделали в строке меню, по ряду на каждую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你在菜单栏中建立的分组各自成行。"
          }
        }
      }
    },
    "Know when your camera, mic or SharePlay is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisse, wann Kamera, Mikrofon oder SharePlay an sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabe cuándo tu cámara, micrófono o SharePlay están activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sachez quand votre caméra, votre micro ou SharePlay est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai quando la fotocamera, il microfono o SharePlay sono attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ、マイク、SharePlayがオンのときにわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라, 마이크 또는 SharePlay가 켜져 있을 때 알 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiba quando sua câmera, microfone ou SharePlay estão ligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайте, когда включены камера, микрофон или SharePlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时知道摄像头、麦克风或同播共享是否开启。"
          }
        }
      }
    },
    "Know when your camera, mic or SharePlay is on. Without Screen Recording the hidden icons flash by for an instant when you click it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisse, wann Kamera, Mikrofon oder SharePlay an sind. Ohne Bildschirmaufnahme blitzen die ausgeblendeten Symbole beim Klick kurz auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabe cuándo tu cámara, micrófono o SharePlay están activos. Sin Grabación de pantalla, los iconos ocultos aparecen un instante al hacer clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sachez quand votre caméra, votre micro ou SharePlay est actif. Sans Enregistrement de l'écran, les icônes masquées apparaissent un instant au clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai quando la fotocamera, il microfono o SharePlay sono attivi. Senza Registrazione schermo le icone nascoste compaiono per un istante al clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ、マイク、SharePlayがオンのときにわかります。画面収録がないと、クリック時に隠れたアイコンが一瞬映ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라, 마이크 또는 SharePlay가 켜져 있을 때 알 수 있습니다. 화면 기록 권한이 없으면 클릭할 때 숨긴 아이콘이 잠깐 스쳐 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiba quando sua câmera, microfone ou SharePlay estão ligados. Sem Gravação de Tela, os ícones ocultos aparecem por um instante ao clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайте, когда включены камера, микрофон или SharePlay. Без записи экрана при щелчке скрытые значки мелькают на мгновение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
