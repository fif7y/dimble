        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の場合：SpotlightからDimbleを再度開くか、区切りまたはメニューバーの空いている場所を右クリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨기면: Spotlight에서 Dimble를 다시 열거나, 구분선 또는 메뉴 막대의 빈 곳을 오른쪽 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ele: reabra o Dimble pelo Spotlight, ou clique com o botão direito em um separador ou em um espaço vazio da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без значка: откройте Dimble через Spotlight или нажмите правой кнопкой на разделитель или пустое место строки меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
