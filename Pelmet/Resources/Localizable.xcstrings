    "Visible, Hidden or Always Hidden. A tag says which.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbar, Ausgeblendet oder Immer ausgeblendet. Ein Label verrät, was gilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibles, Ocultos o Siempre ocultos. Una etiqueta indica cuál."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibles, Masqués ou Toujours masqués. Une étiquette indique lequel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibili, Nascosti o Sempre nascosti. Un’etichetta indica quale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「表示」「非表示」「常に非表示」のどれでも。タグで区別できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시, 숨김 또는 항상 숨김. 태그가 어느 쪽인지 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visíveis, Ocultos ou Sempre ocultos. Uma etiqueta mostra qual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видимые, Скрытые или Всегда скрытые. Метка показывает, какой именно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见、隐藏或始终隐藏。标签会标明是哪一种。"
          }
        }
      }
    },
    "Waiting to Complete First Backup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Fertigstellen des ersten Backup warten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando para completar la primera copia de seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la fin de la première sauvegarde"
          }
        },
        "it": {
