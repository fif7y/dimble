          "stringUnit": {
            "state": "translated",
            "value": "Una griglia sotto la freccia, nell’ordine della tua barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンの下にグリッドで、メニューバーと同じ順に並びます。"
